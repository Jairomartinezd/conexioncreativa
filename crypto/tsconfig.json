{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
      "allowJs": true,
      "noImplicitAny": false,
      "jsx": "react-jsx",        // or "react", depending on your React version/setup
      "esModuleInterop": true,   // Recommended for module interoperability
      "skipLibCheck": true,      // Skips type checking of all declaration files (*.d.ts)
      "forceConsistentCasingInFileNames": true,
      "baseUrl": ".",
      "paths": {
          "*": ["pages/*"]
      },
  },

}
